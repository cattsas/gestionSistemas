# Conexión a MySQL/MariaDB. En XAMPP el usuario root suele no tener password.
DATABASE_URL="mysql://root:@localhost:3306/stock"

# Base auxiliar que Prisma usa para calcular migraciones. Debe existir o el
# usuario debe poder crearla.
SHADOW_DATABASE_URL="mysql://root:@localhost:3306/stock_shadow"

# Base usada por los tests. NUNCA apuntar a la de desarrollo: se trunca entera.
TEST_DATABASE_URL="mysql://root:@localhost:3306/stock_test"

# Secreto para firmar la cookie de sesión. Generar uno propio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# En el servidor debe ser DISTINTO al de desarrollo.
AUTH_SECRET="cambiar-esto-por-un-secreto-generado"

# Marca la cookie de sesión como "secure" (solo viaja por HTTPS).
# Dejar en false si se accede por HTTP plano en la red interna: con true
# el navegador descarta la cookie y el login no funciona.
# Poner en true en cuanto haya HTTPS delante.
COOKIE_SECURE="false"

# Usuario administrador que crea el seed (npm run db:seed).
# Si SEED_ADMIN_PASS queda vacío, el seed genera una password aleatoria
# y la imprime una única vez por consola.
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASS=""
