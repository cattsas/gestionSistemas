generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model articulo {
  id           Int                @id @default(autoincrement())
  id_proveedor Int
  descripcion  String             @db.VarChar(50)
  categoria    articulo_categoria @default(otros)

  proveedor proveedor @relation(fields: [id_proveedor], references: [id], onUpdate: Restrict, map: "articulo_ibfk_1")
  entregas  entrega[]
  lineas    lista[]

  @@index([id_proveedor], map: "id_proveedor")
}

model compra {
  id              Int      @id @default(autoincrement())
  fecha           DateTime @db.Date
  nro_comprobante String   @db.VarChar(20)
  proveedor       Int
  importe_total   Float    @db.Float

  proveedorRef proveedor @relation(fields: [proveedor], references: [id], onUpdate: Restrict, map: "compra_ibfk_1")
  lineas       lista[]

  @@index([proveedor], map: "proveedor")
}

model empleado {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(30)
  sector String @db.VarChar(30)

  entregas       entrega[]
  equipos        equipo[]
  mantenimientos mantenimiento[]
}

model entrega {
  id          Int      @id @default(autoincrement())
  id_articulo Int
  fecha       DateTime @db.Date
  id_empleado Int

  articulo articulo @relation(fields: [id_articulo], references: [id], onUpdate: Restrict, map: "entrega_ibfk_1")
  empleado empleado @relation(fields: [id_empleado], references: [id], onUpdate: Restrict, map: "entrega_ibfk_2")

  @@index([id_articulo], map: "id_articulo")
  @@index([id_empleado], map: "id_empleado")
}

model equipo {
  id            Int         @id @default(autoincrement())
  tipo          equipo_tipo @default(Otros)
  so            String?     @db.VarChar(30)
  ram           Int
  ip            String?     @db.VarChar(15)
  empleado      Int?
  mantenimiento Int?
  observaciones String?     @db.VarChar(500)

  // SetNull y no Cascade: dar de baja a un empleado no debe borrar sus
  // equipos, solo dejarlos sin asignar.
  empleadoRef      empleado?      @relation(fields: [empleado], references: [id], onDelete: SetNull, map: "equipo_ibfk_1")
  mantenimientoRef mantenimiento? @relation(fields: [mantenimiento], references: [id], onDelete: SetNull, map: "equipo_ibfk_2")

  @@index([empleado], map: "emp")
  @@index([mantenimiento], map: "mantenimiento")
}

model lista {
  id              Int   @id @default(autoincrement())
  compra          Int
  articulo        Int
  cantidad        Int
  precio_unitario Float @db.Float
  precio_total    Float @db.Float

  articuloRef articulo @relation(fields: [articulo], references: [id], onUpdate: Restrict, map: "lista_ibfk_1")
  compraRef   compra   @relation(fields: [compra], references: [id], onDelete: Cascade, map: "lista_ibfk_2")

  @@index([compra], map: "compra")
  @@index([articulo], map: "id_articulo")
}

model mantenimiento {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @db.Date
  tarea         String   @db.VarChar(500)
  realizo       Int
  observaciones String   @db.VarChar(500)

  // Restrict: borrar un empleado con mantenimientos registrados debe fallar
  // de forma explicita, no borrar el historial.
  responsable empleado @relation(fields: [realizo], references: [id], onDelete: Restrict, map: "mantenimiento_ibfk_1")
  equipos     equipo[]

  @@index([realizo], map: "responsable")
}

model proveedor {
  id        Int    @id @default(autoincrement())
  nombre    String @unique(map: "nombre") @db.VarChar(30)
  domicilio String @db.VarChar(30)
  telefono  Int

  articulos articulo[]
  compras   compra[]
}

model usuario {
  id      Int    @id @default(autoincrement())
  usuario String @unique(map: "usuario") @db.VarChar(30)
  pass    String @db.VarChar(80)
}

enum equipo_tipo {
  PC
  Impresora
  Notebook
  Otros
}

enum articulo_categoria {
  fuentes
  mothers
  gabinetes
  monitores
  memorias
  discos
  otros
}
